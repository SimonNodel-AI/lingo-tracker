{
  "name": "data-transfer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/data-transfer/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "dependsOn": ["^typecheck", "typecheck-spec"]
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/types/**/*"],
      "options": {
        "cwd": "libs/data-transfer",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/dist/test-results/{projectRoot}"],
      "options": {
        "coverage.reportsDirectory": "../../coverage/libs/data-transfer"
      }
    }
  }
}
