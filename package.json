{
  "name": "@simoncodes-ca/lingo-tracker",
  "version": "0.19.1",
  "description": "Effortlessly Track, Validate, and Manage Your Translations.",
  "bin": {
    "lingo-tracker": "dist/apps/cli/main.cjs",
    "lingo-tracker-app": "dist/apps/api/main.js"
  },
  "scripts": {
    "build:cli": "nx build cli",
    "build:api": "nx build api",
    "prebuild:tracker": "node dist/apps/cli/main.cjs bundle --name tracker",
    "build:tracker": "nx build tracker",
    "build": "pnpm run build:cli && pnpm run build:api && pnpm run build:tracker",
    "serve:api": "nx serve api",
    "serve:tracker": "nx serve tracker",
    "prepare": "node .husky/install.mjs",
    "commit": "git-cz",
    "release": "semantic-release",
    "test:api": "nx test api",
    "test:cli": "nx test cli",
    "test:cli-e2e": "nx e2e cli-e2e",
    "test:core": "nx test core",
    "test:domain": "nx test domain",
    "test:tracker": "nx test tracker",
    "test:data-transfer": "nx test data-transfer",
    "test": "pnpm run test:cli && pnpm run test:api && pnpm run test:core && pnpm run test:domain && pnpm run test:data-transfer && pnpm run test:tracker",
    "test:release": "pnpm run release --dry-run",
    "typecheck:core": "nx typecheck core",
    "typecheck:data-transfer": "nx typecheck data-transfer",
    "typecheck": "pnpm run typecheck:core && pnpm run typecheck:data-transfer",
    "nx": "nx",
    "lint": "pnpm exec biome lint apps libs scripts types && nx run-many -t lint",
    "format": "pnpm exec biome format --write apps libs scripts types",
    "format:check": "pnpm exec biome format apps libs scripts types",
    "format:write": "pnpm exec biome format --write apps libs scripts types",
    "lingo-tracker": "node dist/apps/cli/main.cjs",
    "docs:dev": "cd docs-site && pnpm start",
    "docs:build": "cd docs-site && pnpm build"
  },
  "keywords": [
    "translation",
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "transloco",
    "translation-management",
    "icu",
    "cli",
    "angular"
  ],
  "author": "Simon Nodel",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/simoncodes-ca/lingo-tracker.git"
  },
  "homepage": "https://simoncodes-ca.github.io/lingo-tracker/",
  "bugs": {
    "url": "https://github.com/simoncodes-ca/lingo-tracker/issues"
  },
  "files": [
    "dist/apps/cli",
    "dist/apps/api",
    "dist/apps/tracker",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@swc/core",
      "nx"
    ]
  },
  "nx": {
    "includedScripts": [
      "build:cli",
      "build:api",
      "prebuild:tracker",
      "build:tracker",
      "build",
      "serve:api",
      "serve:tracker",
      "prepare",
      "commit",
      "release",
      "test:api",
      "test:cli",
      "test:cli-e2e",
      "test:core",
      "test:domain",
      "test:tracker",
      "test:data-transfer",
      "test",
      "test:release",
      "typecheck:core",
      "typecheck:data-transfer",
      "typecheck",
      "nx",
      "format",
      "format:check",
      "format:write",
      "lingo-tracker",
      "docs:dev",
      "docs:build"
    ]
  },
